OPENAI_KEY=sk-proj-XXXX
OPENAI_MODEL=gpt-5.6-sol
UI_URL=http://localhost:8080

# Pastas onde o agente pode ler/escrever (separadas por vírgula).
# Padrão: BASE_CODE_PATH → /workspace (Docker) → pasta-pai deste repositório.
DOTY_WORKSPACE_ROOTS=/caminho/absoluto/para/seus/projetos
# Dados do Doty (memória dos projetos). Padrão: ~/.doty. Nunca acessível pelo agente.
# DOTY_DATA_DIR=
# Pasta dos templates de projeto. Padrão: <repo>/templates.
# DOTY_TEMPLATES_DIR=
# Assina os pedidos de aprovação de ferramentas (ex.: comandos Bash), para que o
# cliente não forje aprovações. Padrão: gerado no primeiro start e salvo em
# $DOTY_DATA_DIR/approval-secret (modo 600).
# DOTY_APPROVAL_SECRET=
