# AI providers: only providers with a key show up in the model picker.
# OPENAI_KEY (old name) is still accepted.
OPENAI_API_KEY=sk-proj-XXXX
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Any server compatible with the OpenAI API (OpenRouter, Ollama, LM Studio).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Models of the compatible server, comma-separated (e.g. llama3.3,qwen3-coder).
OPENAI_COMPATIBLE_MODELS=
# Default model (provider:model). Without it: openai:$OPENAI_MODEL, then the first available one.
DOTY_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# Extra OpenAI model that isn't in the catalog (also the default when DOTY_DEFAULT_MODEL is unset).
OPENAI_MODEL=
# Model for sub-agents. Without it: the conversation's model.
DOTY_SUBAGENT_MODEL=
UI_URL=http://localhost:8080

# Folders the agent may read and write (comma-separated).
# Default: BASE_CODE_PATH → /workspace (Docker) → the parent folder of this repository.
DOTY_WORKSPACE_ROOTS=/absolute/path/to/your/projects
# Doty data (project memory). Default: ~/.doty. Never reachable by the agent.
# DOTY_DATA_DIR=
# Folder of the project templates. Default: <repo>/templates.
# DOTY_TEMPLATES_DIR=
# Signs tool approval requests (e.g. Bash commands), so the client can't
# forge approvals. Default: generated on first start and saved to
# $DOTY_DATA_DIR/approval-secret (mode 600).
# DOTY_APPROVAL_SECRET=
