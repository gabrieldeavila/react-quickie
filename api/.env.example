# Provedores de IA: só aparecem no seletor de modelo os que tiverem chave.
# OPENAI_KEY (nome antigo) ainda é aceito.
OPENAI_API_KEY=sk-proj-XXXX
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Qualquer servidor compatível com a API da OpenAI (OpenRouter, Ollama, LM Studio).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Modelos do servidor compatível, separados por vírgula (ex.: llama3.3,qwen3-coder).
OPENAI_COMPATIBLE_MODELS=
# Modelo padrão (provedor:modelo). Sem ele: openai:$OPENAI_MODEL, depois o primeiro disponível.
DOTY_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# Modelo extra da OpenAI que não está no catálogo (também vira padrão sem DOTY_DEFAULT_MODEL).
OPENAI_MODEL=
# Modelo dos subagentes. Sem ele: o modelo da conversa.
DOTY_SUBAGENT_MODEL=
UI_URL=http://localhost:8080

# Pastas onde o agente pode ler/escrever (separadas por vírgula).
# Padrão: BASE_CODE_PATH → /workspace (Docker) → pasta-pai deste repositório.
DOTY_WORKSPACE_ROOTS=/caminho/absoluto/para/seus/projetos
# Dados do Doty (memória dos projetos). Padrão: ~/.doty. Nunca acessível pelo agente.
# DOTY_DATA_DIR=
# Pasta dos templates de projeto. Padrão: <repo>/templates.
# DOTY_TEMPLATES_DIR=
# Assina os pedidos de aprovação de ferramentas (ex.: comandos Bash), para que o
# cliente não forje aprovações. Padrão: gerado no primeiro start e salvo em
# $DOTY_DATA_DIR/approval-secret (modo 600).
# DOTY_APPROVAL_SECRET=
