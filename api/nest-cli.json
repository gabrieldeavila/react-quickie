{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "common/agents/**/*.md",
        "watchAssets": true
      },
      {
        "include": "subagents/definitions/*.md",
        "watchAssets": true
      },
      {
        "include": "instructions/builtin/*.md",
        "watchAssets": true
      }
    ]
  }
}
