{
  "name": "doty",
  "displayName": "Doty",
  "description": "Doty AI assistant in the editor: chat, tools and approvals on the open workspace.",
  "icon": "media/doty-icon.png",
  "version": "0.0.2",
  "publisher": "geavila",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrieldeavila/react-quickie.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "doty",
          "title": "Doty",
          "icon": "media/doty.svg"
        }
      ]
    },
    "views": {
      "doty": [
        {
          "type": "webview",
          "id": "doty.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "doty.newChat",
        "title": "New chat",
        "category": "Doty",
        "icon": "$(add)"
      },
      {
        "command": "doty.showHistory",
        "title": "History",
        "category": "Doty",
        "icon": "$(history)"
      },
      {
        "command": "doty.openSettings",
        "title": "Settings",
        "category": "Doty",
        "icon": "$(gear)"
      },
      {
        "command": "doty.openMcp",
        "title": "MCP servers",
        "category": "Doty",
        "icon": "$(plug)"
      },
      {
        "command": "doty.setApiKey",
        "title": "Set API key",
        "category": "Doty"
      },
      {
        "command": "doty.askAboutSelection",
        "title": "Ask about selection",
        "category": "Doty"
      },
      {
        "command": "doty.restartApi",
        "title": "Restart API",
        "category": "Doty"
      },
      {
        "command": "doty.showLogs",
        "title": "Show logs",
        "category": "Doty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "doty.newChat",
          "when": "view == doty.chatView",
          "group": "navigation@1"
        },
        {
          "command": "doty.showHistory",
          "when": "view == doty.chatView",
          "group": "navigation@2"
        },
        {
          "command": "doty.openSettings",
          "when": "view == doty.chatView",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "doty.askAboutSelection",
          "when": "editorHasSelection",
          "group": "doty"
        }
      ],
      "commandPalette": [
        {
          "command": "doty.askAboutSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "doty.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "doty.chatFocused"
      }
    ],
    "configuration": {
      "title": "Doty",
      "properties": {
        "doty.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model as provider:model (DOTY_DEFAULT_MODEL), e.g. anthropic:claude-sonnet-5-5."
        },
        "doty.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of an OpenAI-compatible server (OPENAI_COMPATIBLE_BASE_URL)."
        },
        "doty.openaiCompatible.models": {
          "type": "string",
          "default": "",
          "description": "Comma-separated models of the OpenAI-compatible server (OPENAI_COMPATIBLE_MODELS)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license --out doty.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
